{
  "name": "app-h5",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "create-page": "ts-node scripts/create-page.ts",
    "dev:benefits": "vite -- --page=benefits",
    "deploy": "vite build && gh-pages -d dist -r https://github.com/captain-young/apph5.git && tsx scripts/print-pages.ts"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "^3.1.0"
  }
}
